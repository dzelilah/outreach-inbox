# SQLite database file, created by `npm run setup`
DATABASE_URL="file:./dev.db"

# Draft rewriter. "mock" (the default) runs offline and needs no key.
# "anthropic" sends the draft, page title, competitor and contact name to the Anthropic API.
LLM_PROVIDER="mock"

# Only used when LLM_PROVIDER="anthropic".
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
